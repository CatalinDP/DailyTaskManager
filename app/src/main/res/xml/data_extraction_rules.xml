<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up tasks, completion history and settings so a new device keeps them. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Whole databases dir so the Room WAL files are backed up together with the db -->
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
